<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.helger.schematron</groupId>
    <artifactId>ph-schematron-parent-pom</artifactId>
    <version>11.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>ph-schematron-xslt</artifactId>
  <packaging>jar</packaging>
  <name>ph-schematron-xslt</name>
  <description>Library for validating XML documents using the original Schematron implementation</description>
  <url>https://github.com/phax/ph-schematron/ph-schematron-xslt</url>
  <inceptionYear>2014</inceptionYear>
  
  <licenses>
    <license>
      <name>Apache 2</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  
  <organization>
    <name>Philip Helger</name>
    <url>https://www.helger.com</url>
  </organization>
  
  <developers>
    <developer>
      <id>philip</id>
      <name>Philip Helger</name>
      <email>ph(at)helger.com</email>
      <url>https://www.helger.com</url>
    </developer>
  </developers>
  
  <dependencies>
    <dependency>
      <groupId>com.helger.commons</groupId>
      <artifactId>ph-xml</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.commons</groupId>
      <artifactId>ph-io</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.schematron</groupId>
      <artifactId>ph-schematron-api</artifactId>
    </dependency>
    
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The XSLT processors for the tests - each surefire execution uses one of them -->
    <dependency>
      <groupId>com.helger.schematron</groupId>
      <artifactId>ph-schematron-saxon</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.helger.schematron</groupId>
      <artifactId>ph-schematron-phoxtrot</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.helger.schematron</groupId>
      <artifactId>ph-schematron-isosch</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.helger.schematron</groupId>
      <artifactId>ph-schematron-testfiles</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sun.xml.bind</groupId>
      <artifactId>jaxb-impl</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.helger.commons</groupId>
      <artifactId>ph-unittest-support-ext</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Run all tests with exactly one XSLT processor on the class path: first Saxon, then phoxtrot -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>com.helger.schematron:ph-schematron-phoxtrot</classpathDependencyExclude>
                <classpathDependencyExclude>com.helger.phoxtrot:phoxtrot-xslt</classpathDependencyExclude>
                <classpathDependencyExclude>com.helger.phoxtrot:phoxtrot-xpath</classpathDependencyExclude>
                <classpathDependencyExclude>com.helger.phoxtrot:phoxtrot-xdm</classpathDependencyExclude>
              </classpathDependencyExcludes>
            </configuration>
          </execution>
          <execution>
            <id>test-phoxtrot</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <reportsDirectory>${project.build.directory}/surefire-reports-phoxtrot</reportsDirectory>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>com.helger.schematron:ph-schematron-saxon</classpathDependencyExclude>
                <classpathDependencyExclude>net.sf.saxon:Saxon-HE</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <excludes>
                <!-- expects that Saxon rejects xsl:result-document (phoxtrot suggestion S36); the phoxtrot variant is in ph-schematron-it -->
                <exclude>com/helger/schematron/SchematronSecureProcessingTest*</exclude>
                <!-- phoxtrot calls the URIResolver with a different base, so the include of the created XSLT is not found (phoxtrot suggestion S39) -->
                <exclude>com/helger/schematron/supplementary/Issue077Test*</exclude>
                <!-- uses Saxon classes -->
                <exclude>com/helger/schematron/supplementary/Issue129Test*</exclude>
                <!-- uses Saxon classes -->
                <exclude>com/helger/schematron/supplementary/Issue137XsltTest*</exclude>
                <!-- uses Saxon classes -->
                <exclude>com/helger/schematron/xslt/SchematronResourceXSLTNativeDOMTest*</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
