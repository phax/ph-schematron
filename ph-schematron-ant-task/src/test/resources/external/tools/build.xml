<project basedir=".">
  <taskdef name="schematron" classname="com.helger.schematron.ant.Schematron" />
  <taskdef name="schematron-convert" classname="com.helger.schematron.ant.SchematronConvert" />
  <taskdef name="schematron-preprocess" classname="com.helger.schematron.ant.SchematronPreprocess" />

  <!-- Warnings and information don't decide -->
  <target name="validate-warnings">
    <schematron schematronFile="levels.sch" expectSuccess="true">
      <fileset dir=".">
        <include name="valid.xml" />
        <include name="warning-info.xml" />
      </fileset>
    </schematron>
  </target>

  <target name="validate-ignore-warnings">
    <schematron schematronFile="levels.sch" expectSuccess="true" ignoreWarnings="true" failOnValidationWarn="true" failOnValidationInfo="true">
      <fileset dir=".">
        <include name="warning-info.xml" />
      </fileset>
    </schematron>
  </target>

  <target name="validate-collect">
    <schematron schematronFile="levels.sch" expectSuccess="true" failFast="false">
      <fileset dir=".">
        <include name="error*.xml" />
      </fileset>
    </schematron>
  </target>

  <target name="validate-lenient">
    <schematron schematronFile="levels.sch" schematronProcessingEngine="pure-xpath" expectSuccess="true" lenient="true">
      <fileset dir=".">
        <include name="valid.xml" />
      </fileset>
    </schematron>
  </target>

  <target name="convert">
    <schematron-convert schematronDirectory="." schematronPattern="levels.sch" xsltDirectory="${outdir}" xsltHeader="Version 1.2.3" showProgress="false" />
    <schematron schematronFile="${outdir}/levels.xslt" schematronProcessingEngine="xslt" expectSuccess="false">
      <fileset dir=".">
        <include name="error.xml" />
      </fileset>
    </schematron>
  </target>

  <target name="convert-invalid-engine">
    <schematron-convert schematronDirectory="." schematronPattern="levels.sch" xsltDirectory="${outdir}" schematronEngine="pure-xpath" />
  </target>

  <target name="preprocess">
    <schematron-preprocess srcFile="abstract.sch" dstFile="${outdir}/preprocessed.sch" schHeader="my header" />
  </target>

  <target name="preprocess-no-overwrite">
    <schematron-preprocess srcFile="abstract.sch" dstFile="${outdir}/existing.sch" overwriteWithoutNotice="false" />
  </target>
</project>
