<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.helger</groupId>
    <artifactId>parent-pom</artifactId>
    <version>3.2.0</version>
  </parent>
  <groupId>com.helger.schematron</groupId>
  <artifactId>ph-schematron-parent-pom</artifactId>
  <version>11.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ph-schematron-parent-pom</name>
  <description>Base POM to build the ph-schematron projects</description>
  <url>https://github.com/phax/ph-schematron</url>
  <inceptionYear>2014</inceptionYear>
 
  <licenses>
    <license>
      <name>Apache 2</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  
  <scm>
    <connection>scm:git:https://github.com/phax/ph-schematron.git</connection>
    <developerConnection>scm:git:https://github.com/phax/ph-schematron.git</developerConnection>
    <url>https://github.com/phax/ph-schematron</url>
    <tag>HEAD</tag>
  </scm>
  
  <distributionManagement>
    <site>
      <id>github.io</id>
      <url>https://phax.github.io/ph-schematron/</url>
    </site>
  </distributionManagement>

  <organization>
    <name>Philip Helger</name>
    <url>https://www.helger.com</url>
  </organization>

  <developers>
    <developer>
      <id>philip</id>
      <name>Philip Helger</name>
      <email>ph(at)helger.com</email>
      <url>https://www.helger.com</url>
    </developer>
  </developers>
  
  <properties>
    <!-- phoxtrot requires Java 21 -->
    <java.version>21</java.version>

    <jaxb-plugin.group>org.jvnet.jaxb</jaxb-plugin.group>
    <jaxb-plugin.artifact>jaxb-maven-plugin</jaxb-plugin.artifact>
    <jaxb-plugin.version>4.0.16</jaxb-plugin.version>
    <ph-jaxb-plugin.version>5.1.3</ph-jaxb-plugin.version>

    <ant.version>1.10.18</ant.version>
    <schxslt1.version>1.10.1</schxslt1.version>
    <schxslt2.version>1.11.3</schxslt2.version>
    <phoxtrot.version>0.3.0</phoxtrot.version>
    <picocli.version>4.7.7</picocli.version>
  </properties>
  
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.helger.commons</groupId>
        <artifactId>ph-commons-bom</artifactId>
        <version>12.7.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.helger.telemetry</groupId>
        <artifactId>ph-telemetry-bom</artifactId>
        <version>1.1.2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.helger.xsd</groupId>
        <artifactId>ph-xsds-bom</artifactId>
        <version>4.1.2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.helger.phoxtrot</groupId>
        <artifactId>phoxtrot-bom</artifactId>
        <version>${phoxtrot.version}</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>

      <dependency>
        <groupId>org.glassfish.jaxb</groupId>
        <artifactId>jaxb-bom</artifactId>
        <version>4.0.9</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>
      
      <dependency>
        <groupId>net.sf.saxon</groupId>
        <artifactId>Saxon-HE</artifactId>
        <version>13.1</version>
        <exclusions>
          <exclusion>
            <groupId>xml-apis</groupId>
            <artifactId>xml-apis</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>${junit4.version}</version>
      </dependency>
      
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-testfiles</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-saxon</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-phoxtrot</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-isosch</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-xslt</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-schxslt</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-schxslt2</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-streamability</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-pure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-pure-xslt</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-validator</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.schematron</groupId>
        <artifactId>ph-schematron-engine-factory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <!-- benchmarks and it don't need to be listed -->
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- All modules require Java 21 (phoxtrot) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-versions</id>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <modules>
    <module>ph-schematron-bom</module>
    <module>ph-schematron-testfiles</module>
    <module>ph-schematron-api</module>
    <module>ph-schematron-saxon</module>
    <module>ph-schematron-phoxtrot</module>
    <module>ph-schematron-xslt</module>
    <module>ph-schematron-isosch</module>
    <module>ph-schematron-schxslt</module>
    <module>ph-schematron-schxslt2</module>
    <module>ph-schematron-model</module>
    <module>ph-schematron-streamability</module>
    <module>ph-schematron-pure-xpath</module>
    <module>ph-schematron-pure-xslt</module>
    <module>ph-schematron-engine-factory</module>
    <module>ph-schematron-validator</module>
    <module>ph-schematron-cli</module>
    <module>ph-schematron-maven-plugin</module>
    <module>ph-schematron-ant-task</module>
    <module>ph-schematron-benchmarks</module>
    <module>ph-schematron-it</module>
  </modules>
</project>
