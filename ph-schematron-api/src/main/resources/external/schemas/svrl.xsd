<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           targetNamespace="http://purl.oclc.org/dsdl/svrl"
           xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
  <xs:import namespace="http://www.w3.org/XML/1998/namespace" />
  <xs:complexType name="SchematronOutputType">
    <!-- [ph] The original RNC uses a choice of two branches that share the
         leading (error, text) prefix:
           (error+, text*)
           | (error*, text*, ns-prefix*, (active-pattern-rule-set ...)+)
         That shared prefix violates Unique Particle Attribution and forces
         JAXB to emit a single untyped catch-all property. We therefore merge
         the branches into one sequence. The only constraint that cannot be
         kept in XSD 1.0 is "at least one error OR at least one pattern block"
         (a cross-branch disjunction). The ordering and the coupling of
         ns-prefix to the pattern block (it only occurs in branch 2) are
         preserved via the optional wrapper sequence below. -->
    <xs:sequence>
      <!-- This is e.g. used for the SchXslt metadata element -->
      <xs:any minOccurs="0" namespace="#other" processContents="lax" />
      <xs:element minOccurs="0" maxOccurs="unbounded" ref="svrl:error"/>
      <xs:element minOccurs="0" maxOccurs="unbounded" ref="svrl:text"/>
      <xs:element minOccurs="0" maxOccurs="unbounded" ref="svrl:ns-prefix-in-attribute-values"/>
      <xs:sequence minOccurs="0" maxOccurs="unbounded">
        <!-- [ph] Modelled as an explicit choice (matching the RNC
             "active-pattern | active-group") instead of an abstract
             substitution group, so JAXB generates concrete ActivePattern /
             ActiveGroup classes instead of JAXBElement wrappers. -->
        <xs:choice>
          <xs:element ref="svrl:active-pattern"/>
          <xs:element ref="svrl:active-group"/>
        </xs:choice>
        <xs:sequence minOccurs="0" maxOccurs="unbounded">
          <xs:choice>
            <xs:element ref="svrl:fired-rule"/>
            <!-- [ph] SchXslt extension: a rule that matched, but was not
                 fired because a previous rule of the same pattern matched the
                 same node -->
            <xs:element ref="svrl:suppressed-rule"/>
          </xs:choice>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element ref="svrl:failed-assert"/>
            <xs:element ref="svrl:successful-report"/>
            <!-- [ph] SchXslt2 extension: an assert that was not checked
                 because its severity is below the severity threshold -->
            <xs:element ref="svrl:skipped-assert"/>
            <!-- [ph] SchXslt2 extension: a report that was not checked
                 because its severity is below the severity threshold -->
            <xs:element ref="svrl:skipped-report"/>
          </xs:choice>
        </xs:sequence>
      </xs:sequence>
    </xs:sequence>
    <xs:attribute name="title"/>
    <!-- [ph] changed from xs:NMTOKEN to xs:string -->
    <xs:attribute name="phase" type="xs:string"/>
    <xs:attribute name="schemaVersion"/>
    <xs:attribute name="schemaFrontEdition"/>
    <!-- [ph] SchXslt2 extension: copied from sch:schema/@schematronEdition -->
    <xs:attribute name="schematronEdition"/>
    <!-- [ph] SchXslt extension: copied from sch:schema/@xml:* -->
    <xs:attributeGroup ref="svrl:attlist.xml"/>
  </xs:complexType>
  <xs:element name="schematron-output" type="svrl:SchematronOutputType" />
  
  <!-- only namespaces from sch:ns need to be reported -->
  <xs:element name="ns-prefix-in-attribute-values">
    <xs:complexType>
      <xs:attribute name="prefix" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="uri" use="required"/>
    </xs:complexType>
  </xs:element>
  <!-- only active patterns and groups are reported -->
  <xs:element name="active-pattern">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="svrl:active"/>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="active-group">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="svrl:active"/>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <!-- only rules that are fired are reported, -->
  <xs:element name="fired-rule">
    <xs:complexType>
      <xs:attribute name="id" type="xs:NCName"/>
      <xs:attribute name="name"/>
      <xs:attribute name="context" use="required"/>
      <xs:attribute name="visit-each"/>
      <xs:attribute name="role" type="xs:string"/>
      <xs:attribute name="flag">
        <xs:simpleType>
          <xs:restriction>
            <xs:simpleType>
              <xs:list itemType="xs:token"/>
            </xs:simpleType>
            <xs:minLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="document" type="xs:anyURI"/>
      <!-- [ph] SchXslt extension: copied from the rule -->
      <xs:attributeGroup ref="svrl:attlist.rich"/>
    </xs:complexType>
  </xs:element>
  <!-- [ph] SchXslt extension, see content/svrl-schxslt.rnc of SchXslt2:
       a rule that matched, but was not fired because a previous rule of the
       same pattern matched the same node. Same attributes as fired-rule. -->
  <xs:element name="suppressed-rule">
    <xs:complexType>
      <xs:attribute name="id" type="xs:NCName"/>
      <xs:attribute name="name"/>
      <xs:attribute name="context" use="required"/>
      <xs:attribute name="visit-each"/>
      <xs:attribute name="role" type="xs:string"/>
      <xs:attribute name="flag">
        <xs:simpleType>
          <xs:restriction>
            <xs:simpleType>
              <xs:list itemType="xs:token"/>
            </xs:simpleType>
            <xs:minLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="document" type="xs:anyURI"/>
      <!-- [ph] SchXslt extension: copied from the rule -->
      <xs:attributeGroup ref="svrl:attlist.rich"/>
    </xs:complexType>
  </xs:element>
  <!-- only references are reported, not the diagnostic -->
  <xs:element name="diagnostic-reference">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="svrl:text"/>
      </xs:sequence>
      <xs:attribute name="diagnostic" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="role"/>
      <!-- [ph] SchXslt extension: copied from sch:diagnostic/@xml:* -->
      <xs:attributeGroup ref="svrl:attlist.xml"/>
    </xs:complexType>
  </xs:element>
  <!-- only failed assertions are reported -->
  <!-- [ph] Own (empty) derived type so JAXB generates a distinct FailedAssert
       class instead of reusing AssertionMessage via a JAXBElement wrapper. -->
  <xs:element name="failed-assert">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="svrl:assertion-message"/>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <!-- only successful asserts are reported -->
  <xs:element name="successful-report">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="svrl:assertion-message"/>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <!-- [ph] SchXslt2 extension, see content/svrl-schxslt.rnc of SchXslt2:
       an assert that was not checked because its severity is below the
       severity threshold. Empty. -->
  <xs:element name="skipped-assert">
    <xs:complexType>
      <xs:attributeGroup ref="svrl:attlist.skipped-assert-and-report"/>
    </xs:complexType>
  </xs:element>
  <!-- [ph] SchXslt2 extension, see content/svrl-schxslt.rnc of SchXslt2:
       a report that was not checked because its severity is below the
       severity threshold. Empty. -->
  <xs:element name="skipped-report">
    <xs:complexType>
      <xs:attributeGroup ref="svrl:attlist.skipped-assert-and-report"/>
    </xs:complexType>
  </xs:element>
  <!-- property-reference -->
  <xs:element name="property-reference">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="svrl:text"/>
      </xs:sequence>
      <xs:attribute name="property" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="role"/>
      <xs:attribute name="scheme"/>
      <!-- [ph] SchXslt extension: copied from sch:property/@xml:* -->
      <xs:attributeGroup ref="svrl:attlist.xml"/>
    </xs:complexType>
  </xs:element>
  <!-- errors raised by the implementation -->
  <xs:element name="error">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="svrl:rich-text">
          <xs:attribute name="document" type="xs:anyURI"/>
          <xs:attribute name="location" use="required"/>
          <xs:attribute name="code"/>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <!-- human text -->
  <xs:element name="text">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="svrl:rich-text">
          <xs:attribute ref="xml:space"/>
          <xs:attribute ref="xml:lang"/>
          <xs:attribute name="see"/>
          <xs:attribute name="icon"/>
          <xs:attribute name="fpi"/>
          <!-- [ph] SchXslt extension: copied from sch:p (id, class) and from
               all attributes of sch:diagnostic (id, role) -->
          <xs:attribute name="id"/>
          <xs:attribute name="class"/>
          <xs:attribute name="role"/>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <!-- rich text -->
  <xs:complexType name="rich-text" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="svrl:foreign"/>
      <xs:element ref="svrl:dir"/>
      <xs:element ref="svrl:span"/>
      <xs:element ref="svrl:emph"/>
    </xs:choice>
    <xs:attributeGroup ref="svrl:foreign"/>
  </xs:complexType>
  <!-- directionality -->
  <xs:element name="dir">
    <xs:complexType mixed="true">
      <xs:attribute name="class"/>
      <xs:attribute name="dir"/>
      <!-- [ph] SchXslt extension: copied from sch:dir/@value -->
      <xs:attribute name="value"/>
      <!-- [ph] SchXslt extension: copied from sch:dir/@xml:* -->
      <xs:attributeGroup ref="svrl:attlist.xml"/>
    </xs:complexType>
  </xs:element>
  <!-- emphasis -->
  <xs:element name="emph">
    <xs:complexType mixed="true">
      <xs:attribute name="class"/>
      <!-- [ph] SchXslt extension: copied from sch:emph/@xml:* -->
      <xs:attributeGroup ref="svrl:attlist.xml"/>
    </xs:complexType>
  </xs:element>
  <!-- arbitrary markup -->
  <xs:element name="span">
    <xs:complexType mixed="true">
      <xs:attribute name="class" use="required"/>
      <!-- [ph] SchXslt extension: copied from sch:span/@xml:* -->
      <xs:attributeGroup ref="svrl:attlist.xml"/>
    </xs:complexType>
  </xs:element>
  <!-- foreign -->
  <xs:group name="foreign">
    <xs:sequence>
      <xs:group minOccurs="0" ref="svrl:foreign-element"/>
    </xs:sequence>
  </xs:group>
  <xs:attributeGroup name="foreign">
    <xs:attributeGroup ref="svrl:foreign-attributes"/>
  </xs:attributeGroup>
  <xs:attributeGroup name="foreign-attributes">
    <!-- [ph] exclude local attributes -->
    <xs:anyAttribute namespace="##other" processContents="skip"/>
  </xs:attributeGroup>
  <xs:group name="foreign-element">
    <xs:choice>
      <xs:any namespace="##other" processContents="skip"/>
      <xs:any namespace="##local" processContents="skip"/>
    </xs:choice>
  </xs:group>
  <xs:attributeGroup name="attlist.assert-and-report">
    <xs:attribute name="id" type="xs:NCName"/>
    <xs:attribute name="location" use="required"/>
    <xs:attribute name="test" use="required"/>
    <xs:attribute name="role" type="xs:string"/>
    <xs:attribute name="flag">
      <xs:simpleType>
        <xs:restriction>
          <xs:simpleType>
            <xs:list itemType="xs:token"/>
          </xs:simpleType>
          <xs:minLength value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="severity" type="xs:string"/>
    <xs:attributeGroup ref="svrl:attlist.schxslt-assert-and-report"/>
    <!-- [ph] SchXslt extension: copied from the assert or report -->
    <xs:attributeGroup ref="svrl:attlist.rich"/>
  </xs:attributeGroup>
  <!-- [ph] SchXslt2 extension, see content/svrl-schxslt.rnc of SchXslt2:
       the IDs of the containing rule and pattern or group. SchXslt2 also adds
       xml:lang (see attlist.rich) if the language of the assert or report
       differs from the one of the schema. -->
  <xs:attributeGroup name="attlist.schxslt-assert-and-report">
    <xs:attribute name="ruleId" type="xs:NMTOKEN"/>
    <xs:attribute name="patternId" type="xs:NMTOKEN"/>
    <xs:attribute name="groupId" type="xs:NMTOKEN"/>
  </xs:attributeGroup>
  <!-- [ph] SchXslt extension: SchXslt copies all xml:* attributes of the
       Schematron element (xml:lang, xml:space, but also e.g. xml:id or
       xml:base) to the SVRL element. xml:lang and xml:space are declared to
       get typed properties, the others are covered by the wildcard. -->
  <xs:attributeGroup name="attlist.xml">
    <xs:attribute ref="xml:lang"/>
    <xs:attribute ref="xml:space"/>
    <xs:anyAttribute namespace="http://www.w3.org/XML/1998/namespace" processContents="skip"/>
  </xs:attributeGroup>
  <!-- [ph] SchXslt extension: SchXslt copies see, icon, fpi and all xml:*
       attributes of rules, asserts and reports to the SVRL. Up to
       ph-schematron 9.2.0 this group was part of the XML Schema. -->
  <xs:attributeGroup name="attlist.rich">
    <xs:attribute name="see"/>
    <xs:attribute name="icon"/>
    <xs:attribute name="fpi"/>
    <xs:attributeGroup ref="svrl:attlist.xml"/>
  </xs:attributeGroup>
  <!-- [ph] SchXslt2 extension: attributes of skipped-assert and
       skipped-report - the ones of failed-assert and successful-report plus
       the severity threshold -->
  <xs:attributeGroup name="attlist.skipped-assert-and-report">
    <xs:attribute name="severityThreshold" type="xs:token" use="required"/>
    <xs:attributeGroup ref="svrl:attlist.assert-and-report"/>
  </xs:attributeGroup>
  <!-- active patterns and rule-sets -->
  <xs:complexType name="active">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" ref="svrl:error"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:NCName"/>
    <xs:attribute name="documents" type="xs:anyURI"/>
    <xs:attribute name="name"/>
    <xs:attribute name="role" type="xs:string"/>
    <!-- [ph] SchXslt extension: copied from sch:pattern/@xml:* -->
    <xs:attributeGroup ref="svrl:attlist.xml"/>
  </xs:complexType>
  <!-- assert and report message -->
  <xs:complexType name="assertion-message">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" ref="svrl:diagnostic-reference"/>
      <xs:element minOccurs="0" maxOccurs="unbounded" ref="svrl:property-reference"/>
      <xs:element ref="svrl:text"/>
    </xs:sequence>
    <xs:attributeGroup ref="svrl:attlist.assert-and-report"/>
  </xs:complexType>
</xs:schema>
